{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-app",
  "description": "本地页面（启动页、离线页、更新中心、下载页）的权限。远程站点不在这里，拿不到任何命令。",
  "windows": ["main", "updater", "downloads"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-bootstrap",
    "allow-app-info",
    "allow-get-settings",
    "allow-save-settings",
    "allow-probe-servers",
    "allow-open-server",
    "allow-open-home",
    "allow-open-updater",
    "allow-open-external",
    "allow-check-update",
    "allow-update-state",
    "allow-open-logs-dir",
    "allow-diagnostics",
    "allow-restart-app",
    "allow-log-message",
    "allow-download-list",
    "allow-download-start",
    "allow-download-cancel",
    "allow-download-delete",
    "allow-download-open",
    "allow-download-folder"
  ]
}
